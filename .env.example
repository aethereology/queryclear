# QueryClear environment template
# Copy to .env.local for local development. Never commit real secret values.
# Production values belong in the deployment secret manager and must be set for
# the correct environment (production/preview/development) explicitly.

# Site identity
NEXT_PUBLIC_SITE_URL=https://www.queryclear.com
# Optional consent-gated GA4. Leave blank to keep analytics completely inactive.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required: durable operations / rate-limit / audit state (Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required: transactional email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
LEAD_TO=hello@queryclear.com
LEAD_FROM=QueryClear <hello@queryclear.com>
FOUNDER_ALERT_TO=hello@queryclear.com

# Required: paid checkout and payment lifecycle
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fail closed by default. Set to false only after paid-audit fulfillment capacity
# and every production checkout gate in docs/operations are signed off.
AUDIT_CHECKOUT_PAUSED=true

# Required: private client reports and signed access
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Random secret of at least 32 characters; rotate under the report-access runbook.
REPORT_ACCESS_SECRET=

# Required: public audit runtime. Use HTTPS in production and set the same random
# shared secret in the marketing site and queryclearagent runtime.
AGENT_RUNTIME_URL=
AGENT_RUNTIME_SHARED_SECRET=
AGENT_RUNTIME_TIMEOUT_MS=45000
PUBLIC_AUDIT_ORG_ID=
PUBLIC_AUDIT_DOMAIN_ID=
PUBLIC_AUDIT_DAILY_CAP_USD=5
PUBLIC_AUDIT_COST_USD=0.01
PUBLIC_AUDIT_IP_LIMIT=5
PUBLIC_AUDIT_IP_WINDOW_MS=3600000
# Hard-capped by code at 24 hours.
PUBLIC_AUDIT_REPORT_TTL_MS=86400000

# Scheduled jobs / QStash
CRON_SECRET=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Outreach stays disabled until the legal, sourcing, suppression, deliverability,
# monitoring, and capacity launch gates are signed off.
OUTREACH_PAUSED=true
# Random founder-only secret of at least 32 characters.
OUTREACH_SECRET=
OUTREACH_ORG_ID=
OUTREACH_DOMAIN_ID=
OUTREACH_DAILY_SEND_CAP=25
OUTREACH_TICK_TOUCH_MAX=3
OUTREACH_TICK_COLD_MAX=2
OUTREACH_QUEUE_TARGET_DEPTH=75
OUTREACH_QUEUE_LOW_WATERMARK=50
OUTREACH_REPORT_TTL_MS=2592000000
OUTREACH_OPEN_ACK_ENABLED=false
OUTREACH_OPEN_ACK_DELAY_MINUTES=5
OUTREACH_POSTAL_ADDRESS=6120 Caladesi Ct, Jacksonville, FL 32258

# Optional public-web sourcing and spend guardrails
APIFY_TOKEN=
APIFY_DAILY_CAP_USD=1
APIFY_COST_PER_CITY_USD=1
APIFY_EST_YIELD_PER_RUN=20

# Optional Microsoft 365 mailbox integration
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_MAILBOX=

# Optional social operations. Keep credentials empty until each channel is
# approved and the admin/job security controls are configured.
OPENAI_API_KEY=
# Random dedicated admin secret of at least 32 characters. Login rate limiting
# requires the durable KV settings above.
SOCIAL_ADMIN_SECRET=
SOCIAL_JOB_SECRET=
SOCIAL_ENCRYPTION_KEY=
SOCIAL_DRAFT_MODEL=gpt-5.6-luna
SOCIAL_REVIEW_MODEL=gpt-5.6-terra
SOCIAL_TTS_MODEL=gpt-4o-mini-tts
SOCIAL_RENDER_CALLBACK_SECRET=
SOCIAL_RENDER_GITHUB_TOKEN=
SOCIAL_RENDER_GITHUB_REPO=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_BRAND_CLIENT_ID=
LINKEDIN_BRAND_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202605
LINKEDIN_FOUNDER_URN=
LINKEDIN_ORGANIZATION_URN=

X_CLIENT_SECRET=
X_WEBHOOK_SECRET=
X_FOUNDER_ACCESS_TOKEN=
X_FOUNDER_USER_ID=
X_BRAND_ACCESS_TOKEN=
X_BRAND_USER_ID=

META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

REDDIT_ACCESS_TOKEN=
REDDIT_ALLOWLIST=
REDDIT_USER_AGENT=web:queryclear-social:v1.0 (by /u/queryclear)
REDDIT_USERNAME=

# Generated social media, when enabled, reuses the Blob credential above.
